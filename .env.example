# PiVideoStudio 环境变量配置
# 复制为 .env 并填写实际值

# === 视频生成供应商 ===
# mock / minimax / keling / jimeng
VIDEO_PROVIDER=mock

# === MiniMax H3 (metaso.cn) ===
MINIMAX_BASE_URL=https://metaso.cn/api/minimax
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-H3
MINIMAX_RESOLUTION=768P
MINIMAX_DURATION=5
MINIMAX_RATIO=16:9

# === LLM ===
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MOCK_MODE=false

# === PiNovelStudio 对接 ===
NOVEL_STUDIO_BASE_URL=
NOVEL_STUDIO_TOKEN=

# === 数据库 ===
PIVIDEO_DB_PATH=storage/pivideo.db

# === Web ===
PIVIDEO_WEB_URL=http://localhost:5173

# === API ===
PORT=3100
# 首帧链（联调期默认关）
ENABLE_FIRST_FRAME_CHAIN=false
# 自动 QC 三级分流（默认关）
ENABLE_AUTO_QC=false
# 音频策略（默认 hybrid）
AUDIO_STRATEGY=hybrid
# 字幕烧录（默认 off）
SUBTITLE_BURN=off
ENABLE_CONTENT_SAFETY=false
# === v1.1 模型路由 ===
# 质量档位：test（全走 minimax/MiniMax-H3）| prod（seedance 分流）
QUALITY_TIER=test
# === Seedance（火山引擎方舟）===
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com
SEEDANCE_API_KEY=
SEEDANCE_MODEL=seedance-2.5
SEEDANCE_RESOLUTION=720p
SEEDANCE_RATIO=16:9
