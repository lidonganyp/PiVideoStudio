{
  "name": "pivideo-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PiVideoStudio：小说转视频生成平台（独立开发，后续与 PiNovelStudio 融合）",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=20.19"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev:api": "pnpm --filter @pivideo/api dev",
    "dev:web": "pnpm --filter @pivideo/web dev",
    "dev:worker": "pnpm --filter @pivideo/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  }
}
